# Public (exposed to browser) — safe because Supabase anon key is RLS-gated
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_USER_EMAIL=chinopun2008@gmail.com

# Server-only — used by /api/finnhub route, never exposed to the client
FINNHUB_KEY=YOUR_FINNHUB_KEY

# Optional password gate for the whole site. Leave blank to disable.
DASHBOARD_PASSWORD=
